						.replyText("testUpdate")
						.build();
		
		
		//when
		replyMapper.update(replyDTO);
		
		//then
		ReplyDTO result = replyMapper.read(1);
		log.info(result);
		
	}
	
	
	@Test
	void testListOfBoard() {
		//given
		int bno = 1;
		
		//when
		List<ReplyDTO> list = replyMapper.listOfBoard(bno, 0, 5);
		
		//then
