package service;

import static org.junit.jupiter.api.Assertions.*;

import java.util.List;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.ContextConfiguration;
import org.springframework.test.context.junit.jupiter.SpringExtension;

import dto.BoardDTO;
import lombok.extern.log4j.Log4j2;

@Log4j2
@ExtendWith(SpringExtension.class)
@ContextConfiguration("file:src/main/webapp/WEB-INF/spring/root-context.xml")
class BoardServiceTest {

	@Autowired
	private BoardService boardService;
	
	@Test
	void testSelectAll() {
		//given
		
		//when
		List<BoardDTO> list = boardService.selectAll();	
		
		//then
		assertNotNull(list);
		list.forEach(m -> log.info(m));
	}

	@Test
	void testModify() {
		//given
		int seq = 2;
				
		//when
		BoardDTO modify = boardService.detailByOne(seq);
		
		//then
		assertNotNull(modify);
		log.info(modify);
	}

	@Test
	void testInsert() {
		//given
		BoardDTO dto = BoardDTO.builder()
						.writer("user01")	// member테이블 id와 참조무결성 제약이라서 id에 있는 값만 사용해야함.
						.title("testservice")
						.content("testservice")
						.build();
		
		//when
		boardService.insert(dto);
		
		//then
		assertNotNull(dto);
		testSelectAll();
	}

	@Test
	void testDelete() {
		//given
		int seq = 4;
		
		//when
		boardService.delete(seq);
		
		//then
	}

	@Test
	void testUpdate() {
		//given
		int seq = 4;
		
		BoardDTO dto = BoardDTO.builder()
				.seq(seq)
				.title("test_service_update_1")
				.content("test_service_update_1")
				.build();
		//when
		boardService.update(dto);;
		
		//then
		assertNotNull(dto);
		
		testSelectAll();
	}
	
	@Test
	void testPlusHit() {
		//given
		int seq = 3;
		
		//when
		boardService.plusHit(seq);
		
		//then
		
	}

	
	@Test
	void testGetTotalCount() {
		//given
		
		
		//when
		int totalCount = boardService.getTotalCount();
		
		//then
		log.info("총 게시물 수 : " + totalCount);
		
	}
	
	@Test
	void testGetTodayCount() {
		//given
		
		
		//when
		int totalCount = boardService.getTodayCount();
				
		//then
		log.info("오늘 게시물 수 : " + totalCount);		
	}
}
