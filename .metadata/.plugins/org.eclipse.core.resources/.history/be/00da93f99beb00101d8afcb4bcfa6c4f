<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.BoardMapper">

<select id="selectAll" resultType="dto.BoardDTO">
select seq, writer, title, content, hit, regdate, updatedate
from board
where delflag = 0
order by seq desc;
</select>

<select id="detailByOne" resultType="dto.BoardDTO">
select seq, writer, title, content, hit, regdate
from board
where delflag = 0 and seq = #{seq};
</select>

<insert id="insert" parameterType="dto.BoardDTO">
insert into board (writer, title, content) 
values (#{writer} ,#{title}, #{content})
</insert>

<update id="update" parameterType="dto.BoardDTO">
update board 
set title=#{title}, content=#{content}
where seq=#{seq}
</update>

<update id="delete" parameterType="int">
update board set delflag=true
where seq=#{seq}
</update>

<update id="plusHit">
    UPDATE board
    SET hit = hit + 1 
    WHERE seq = #{seq}
</update>

<select id="getTotalCount" resultType="int">
	select count(*) from board
	where delflag = 0;
</select>

<select id="getTodayCount" resultType="int">
	select count(*) from board
	where date(regdate) = curdate() and delflag = 0;
</select>

<select id="getListPaging">
	select seq, title, writer, content, regdate, hit
	from board
	where delflag = false
	order by seq desc
	limit #{size} offset #{skip};
</select>

<select id="getPagingCount" resultType="int">
	select count(seq)
	from board
	where delflag = false;
</select>

<select id="listSearch" resultType="dto.BoardDTO">
    SELECT seq, writer, title, content, hit, regdate, updatedate, delflag
    FROM board
    <where>
    	<if test="role != 'ADMIN'">
            AND delflag = 0
        </if>
        <if test="types != null and keyword != null and keyword != ''">
            <choose>
                <when test="types == 't'.toString()">
                    AND title LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'c'.toString()">
                    AND content LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'w'.toString()">
                    AND writer LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'tc'.toString()">
                    AND (title LIKE CONCAT('%', #{keyword}, '%') OR content LIKE CONCAT('%', #{keyword}, '%'))
                </when>
            </choose>
        </if>
    </where>
    ORDER BY seq DESC
    LIMIT #{skip}, #{size}
</select>

<select id="listCountSearch" resultType="int">
    SELECT COUNT(*) FROM board
    <where>
    	<if test="role != 'ADMIN'">
            AND delflag = 0
        </if>
        <if test="types != null and keyword != null and keyword != ''">
            <choose>
                <when test="types == 't'.toString()">
                    AND title LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'c'.toString()">
                    AND content LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'w'.toString()">
                    AND writer LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="types == 'tc'.toString()">
                    AND (title LIKE CONCAT('%', #{keyword}, '%') OR content LIKE CONCAT('%', #{keyword}, '%'))
                </when>
            </choose>
        </if>
    </where>
</select>

</mapper>