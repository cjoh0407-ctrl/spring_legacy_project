	}
	
	
	@Test
	void insertTest() {
		//given
		MemberDTO dto = MemberDTO.builder()
						.id("test")
						.name("test1")
						.password("1234")
						.email("test1@test.com")
						.phone("010-1111-1111")
						.role("admin")
						.build();
		
		//when
		memberMapper.insert(dto);
		
		String id = "test";
		
		//then
		MemberDTO result = memberMapper.selectById(id);
		
		log.info(result);
		
	}
	
	@Test
	void updateTest() {
		//given
		String id = "test";
		
		MemberDTO dto = MemberDTO.builder()
				.name("test1")
				.password("1234")
				.email("testupdate1@test.com")
				.phone("010-1111-1111")
				.role("admin")
				.id(id)
				.build();
		
		//when
		memberMapper.update(dto);
		
		//then
		MemberDTO result = memberMapper.selectById(id);
		
		log.info(result);
	}
	
	@Test
	void deleteTest() {
		//given
		
		
		//when
		String id = "test";
		memberMapper.delete(id);
		
		//then
		selectAllTest();
		
	}
	
	
	@Test
	void getTotalMemberCountTest() {
		//given
		
		
		//when
		int totalMemberCount = memberMapper.getTotalMemberCount();
		
		//then
		log.info("총 회원 수 : " + totalMemberCount);
	}
	
	
	@Test
	void getRecentMembersTest() {
		//given
		
		
		//when
		List<MemberDTO> recentMembers = memberMapper.getRecentMembers();
		
		//then
		assertNotNull(recentMembers);
		recentMembers.forEach(m -> log.info(m));	
	}
	
	
	@Test
	void loginTest() {
		//given
		
		//when
