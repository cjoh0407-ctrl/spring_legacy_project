<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>관리자 - 회원 관리</title>
<style>
    body { margin: 0; font-family: 'Malgun Gothic', sans-serif; display: flex; background-color: #f4f7f6; }
    .sidebar { width: 240px; background: #2c3e50; color: white; height: 100vh; position: fixed; }
    .sidebar-header { padding: 20px; text-align: center; background: #1a252f; font-size: 20px; font-weight: bold; }
    .sidebar-menu { padding: 0; list-style: none; }
    .sidebar-menu li a { display: block; padding: 15px 25px; color: #bdc3c7; text-decoration: none; border-bottom: 1px solid #34495e; }
    .sidebar-menu li a:hover { background: #34495e; color: white; }
    .sidebar-menu li a.active { background: #3498db; color: white; }
    .main-content { margin-left: 240px; width: calc(100% - 240px); }
    .admin-header { height: 60px; background: white; border-bottom: 1px solid #ddd; display: flex; align-items: center; justify-content: flex-end; padding: 0 30px; }
    .container { padding: 30px; }
    .page-title { margin-bottom: 10px; color: #333; }
    .search-wrapper { margin-bottom: 20px; display: flex; justify-content: flex-end; gap: 8px; }
    .search-wrapper select, .search-wrapper input { padding: 8px; border: 1px solid #ddd; border-radius: 4px; outline: none; }
    .search-wrapper button { padding: 8px 18px; background: #2c3e50; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .admin-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .admin-table th { background: #f8f9fa; padding: 15px; border-bottom: 2px solid #dee2e6; color: #495057; font-size: 14px; }
    .admin-table td { padding: 15px; border-bottom: 1px solid #eee; text-align: center; font-size: 14px; color: #666; }
    .badge { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; }
    .badge-admin { background: #e8f4fd; color: #3498db; }
    .badge-user { background: #f1f3f5; color: #868e96; }
    .badge-active { background: #e6fffa; color: #38b2ac; }
    .badge-disabled { background: #fff5f5; color: #e74c3c; }
    .disabled-row { background-color: #fcfcfc; }
    .disabled-row td { color: #ccc !important; }
    .btn-action { border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; min-width: 70px; }
    .btn-kick { background: #e74c3c; color: white; }
    .btn-restore { background: #3498db; color: white; }
    .pagination { display: flex; justify-content: center; list-style: none; padding: 0; margin-top: 30px; gap: 5px; }
    .pagination li a { display: block; padding: 8px 14px; border: 1px solid #ddd; text-decoration: none; color: #333; border-radius: 4px; background: white; }
    .pagination li.active a { background: #3498db; color: white; border-color: #3498db; }
</style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">회원 관리</div>
        <ul class="sidebar-menu">
            <li><a href="/admin/main">대시보드 메인</a></li>
            <li><a href="/admin/board/list">게시판 관리</a></li>
            <li><a href="/admin/member/list" class="active">회원 관리</a></li>
        </ul>
    </div>

    <div class="main-content">
        <header class="admin-header">
            <span>관리자 <b>${sessionScope.member.name}</b>님</span>
        </header>

        <div class="container">
            <h1 class="page-title">회원 관리</h1>
            
            <div class="search-wrapper">
                <select id="searchType">
                    <option value="i">아이디</option>
                    <option value="n">이름</option>
                    <option value="e">이메일</option>
                </select>
                <input type="text" id="searchKeyword" placeholder="검색어 입력">
                <button type="button" onclick="loadMemberList(1)">검색</button>
            </div>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="100">상태</th>
                        <th width="150">아이디</th>
                        <th width="120">이름</th>
                        <th>이메일</th>
                        <th width="100">권한</th>
                        <th width="120">가입일</th>
                        <th width="120">관리</th>
                    </tr>
                </thead>
                <tbody id="memberListBody">
                    <tr><td colspan="7">로딩 중...</td></tr>
                </tbody>
            </table>

            <ul class="pagination" id="memberPaging"></ul>
        </div>
    </div>

<script>
	const loginId = '${sessionScope.member != null ? sessionScope.member.id : ""}';
    let currentPage = 1;

    document.addEventListener("DOMContentLoaded", function() {
        loadMemberList(1);
    });

    function loadMemberList(page) {
        currentPage = page;
        const type = document.getElementById("searchType").value;
        const keyword = document.getElementById("searchKeyword").value;
        
        const url = "/admin/member/api/list?page=" + page + "&size=10&types=" + type + "&keyword=" + encodeURIComponent(keyword);

        fetch(url)
            .then(res => res.json())
            .then(data => {
                console.log("받은 데이터:", data);
                // JSON 구조가 memberDTOList 인지 확인
                printTable(data.memberDTOList); 
                printPaging(data);
            })
            .catch(err => {
                console.error("실패:", err);
            });
    }

    function printTable(list) {
        const tbody = document.getElementById("memberListBody");
        let str = "";
        
        if(!list || list.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="padding:50px;">데이터가 없습니다.</td></tr>';
            return;
        }

        list.forEach(m => {
            // 1. null 방어 로직 (데이터가 null이어도 자바스크립트가 안 멈추게 함)
            const mid = m.id || "-";
            const mname = m.name || "-";
            const memail = m.email || "-";
            const mrole = m.role || "MEMBER"; // role이 null이면 MEMBER로 표시
            const enabled = m.enabled; // true/false
            const regDate = m.regdateShort || "-"; // 보내주신 JSON의 regdateShort 사용

            const disabledClass = enabled ? "" : "disabled-row";
            const statusBadge = enabled ? "badge-active" : "badge-disabled";
            const statusText = enabled ? "활동중" : "탈퇴됨";
            const roleBadge = mrole === 'ADMIN' ? "badge-admin" : "badge-user";

            str += `<tr class="${disabledClass}">`;
            str += `    <td><span class="badge ${statusBadge}">${statusText}</span></td>`;
            str += `    <td><b>${mid}</b></td>`;
            str += `    <td>${mname}</td>`;
            str += `    <td>${memail}</td>`;
            str += `    <td><span class="badge ${roleBadge}">${mrole}</span></td>`;
            str += `    <td>${regDate}</td>`;
            str += `    <td>`;
            
            if(mid !== loginId) {
                if(enabled) {
                    str += `<button type="button" class="btn-action btn-kick" onclick="changeStatus('${mid}', false)">탈퇴</button>`;
                } else {
                    str += `<button type="button" class="btn-action btn-restore" onclick="changeStatus('${mid}', true)">복구</button>`;
                }
            } else {
                str += `<span class="badge badge-admin">나</span>`;
            }
            str += `    </td>`;
            str += `</tr>`;
        });
        tbody.innerHTML = str;
    }

    function printPaging(data) {
        const pagingUl = document.getElementById("memberPaging");
        let str = "";
        if(data.prev) {
            str += `<li><a href="javascript:loadMemberList(${data.start - 1})">이전</a></li>`;
        }
        data.pageNums.forEach(num => {
            const activeClass = (data.page === num) ? "active" : "";
            str += `<li class="${activeClass}"><a href="javascript:loadMemberList(${num})">${num}</a></li>`;
        });
        if(data.next) {
            str += `<li><a href="javascript:loadMemberList(${data.end + 1})">다음</a></li>`;
        }
        pagingUl.innerHTML = str;
    }

    function changeStatus(id, enabled) {
        if(!confirm(id + " 회원의 상태를 변경하시겠습니까?")) return;
        fetch("/admin/updateEnabled", {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: "id=" + id + "&enabled=" + enabled
        })
        .then(res => res.text())
        .then(msg => {
            alert(msg);
            loadMemberList(currentPage);
        });
    }
</script>
</body>
</html>