<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.BoardMapper">

<select id="selectAll" resultType="dto.boardDTO">
select seq, writer, content, hit, regdate
from board
order by seq desc;
</select>

<select id="modify" resultType="dto.boardDTO">
select seq, writer, content, hit, regdate
from board
where seq = #{seq};
</select>

<insert id="insert" parameterType="dto.boardDTO">
insert into board (title, content, regdate) 
values (#{title}, #{content})
</insert>

<update id="update" parameterType="dto.boardDTO">
update board set title=#{title}, content=#{content}, updatedate=now
</update>

</mapper>