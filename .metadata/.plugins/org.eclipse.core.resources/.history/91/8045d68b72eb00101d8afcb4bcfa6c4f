<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>게시글 상세보기</title>
<style>
    /* ... 기존 스타일 유지 ... */

    /* 댓글 영역 스타일 추가 */
    #replyList { list-style: none; padding: 0; margin-top: 20px; }
    .reply-item { 
        background: #fff; 
        border-bottom: 1px solid #eee; 
        padding: 20px 10px; 
        transition: 0.3s;
    }
    .reply-item:hover { background-color: #fcfcfc; }
    .reply-header { display: flex; justify-content: space-between; margin-bottom: 8px; }
    .replyer-name { font-weight: bold; color: #333; font-size: 15px; }
    .reply-text { color: #555; font-size: 15px; line-height: 1.6; }

    /* 페이징 버튼 스타일 디자인 */
    .paging-btn {
        display: inline-block;
        padding: 8px 14px;
        margin: 0 4px;
        border: 1px solid #ddd;
        border-radius: 4px;
        color: #666;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: 0.2s;
    }
    .paging-btn:hover { background-color: #f4f4f4; border-color: #bbb; }
    .paging-btn.active { 
        background-color: #007bff; 
        color: white; 
        border-color: #007bff; 
    }
    .paging-arrow { background-color: #f9f9f9; font-weight: bold; }
</style>

<div class="container" style="margin-top: 20px;">
    <h3 style="border-left: 5px solid #007bff; padding-left: 15px; margin-bottom: 25px;">
        댓글 <span id="replyCount" style="color: #007bff;">0</span>
    </h3>
    
    <div style="background: #f9f9f9; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <textarea id="replyText" placeholder="상대방을 비방하는 댓글은 삭제될 수 있습니다." 
                  style="width: 100%; height: 80px; padding: 12px; border-radius: 6px; border: 1px solid #ddd; resize: none; box-sizing: border-box;"></textarea>
        <div style="text-align: right; margin-top: 10px;">
            <button id="addReplyBtn" class="btn btn-modify" style="padding: 12px 30px;">댓글 등록</button>
        </div>
    </div>

    <ul id="replyList">
        </ul>

    <div id="replyPaging" style="display: flex; justify-content: center; margin-top: 40px; padding-bottom: 20px;">
        </div>
</div>

<script>
    const bno = "${board.seq}"; 
    
    document.addEventListener("DOMContentLoaded", function() {
        printReplies(1); 
    });

    function printReplies(page) {
        const url = "/reply/list/" + bno + "?page=" + page;

        fetch(url)
            .then(res => {
                if(!res.ok) throw new Error("데이터 로드 실패");
                return res.json();
            })
            .then(data => {
                document.getElementById("replyCount").innerText = data.totalCount;
                let replyUL = document.getElementById("replyList");
                let str = "";
                
                if(data.replyList && data.replyList.length > 0) {
                    data.replyList.forEach(reply => {
                        str += '<li class="reply-item">';
                        str += '    <div class="reply-header">';
                        str += '        <span class="replyer-name">👤 ' + reply.replyer + '</span>';
                        str += '    </div>';
                        str += '    <div class="reply-text">' + reply.replyText + '</div>';
                        str += '</li>';
                    });
                } else {
                    str = '<li style="text-align:center; padding: 50px 0; color: #999;">첫 번째 댓글을 남겨보세요.</li>';
                }
                replyUL.innerHTML = str;
                printPaging(data);
            })
            .catch(err => console.error(err));
    }

    function printPaging(data) {
        let pagingDiv = document.getElementById("replyPaging");
        let str = "";

        // [이전] 버튼
        if(data.prev) {
            str += "<a href='javascript:printReplies(" + (data.start - 1) + ")' class='paging-btn paging-arrow'>&lt;</a>";
        }

        // 페이지 번호
        data.pageNums.forEach(num => {
            let activeClass = (num === data.page) ? "active" : "";
            str += "<a href='javascript:printReplies(" + num + ")' class='paging-btn " + activeClass + "'>" + num + "</a>";
        });

        // [다음] 버튼
        if(data.next) {
            str += "<a href='javascript:printReplies(" + (data.end + 1) + ")' class='paging-btn paging-arrow'>&gt;</a>";
        }
        pagingDiv.innerHTML = str;
    }
</script>

</body>
</html>