package service;

import static org.junit.jupiter.api.Assertions.*;

import java.util.List;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.ContextConfiguration;
import org.springframework.test.context.junit.jupiter.SpringExtension;

import dto.MemberDTO;
import lombok.extern.log4j.Log4j2;

@Log4j2
@ExtendWith(SpringExtension.class)
@ContextConfiguration("file:src/main/webapp/WEB-INF/spring/root-context.xml")
class MemberServiceTest {

	@Autowired
	private MemberService memberService;
	
	@Test
	void testSelectAll() {
		//given
		
		//when 
		List<MemberDTO> selectAll = memberService.selectAll();
		
		//then
		assertNotNull(selectAll);
		selectAll.forEach(m -> log.info(m));
	}

	@Test
	void testSelectById() {
		//given
		String id = "test";
		
		//when
		MemberDTO dto = memberService.selectById(id);
		
		//then
		log.info(dto);
	}

	@Test
	void testInsert() {
		//given
		MemberDTO dto = MemberDTO.builder()
				.id("test2")
				.name("test2")
				.password("1234")
				.email("test2@test.com")
				.phone("010-1111-1111")
				.role("admin")
				.build();
		
		//when
		memberService.insert(dto);
		List<MemberDTO> selectAll = memberService.selectAll();
		
		//then
		assertNotNull(selectAll);
		selectAll.forEach(m -> log.info(m));
	}

	@Test
	void testUpdate() {
		//given
		String id = "test";
		
		MemberDTO dto = MemberDTO.builder()
				.name("test")
				.password("1234")
				.email("testupdate3@test.com")
				.phone("010-1111-1111")
				.role("admin")
				.id(id)
				.build();
		
		//when
		memberService.update(dto);
		
		//then
		MemberDTO result = memberService.selectById(id);
		
		log.info(result);
	}

	@Test
	void testDelete() {
		//given
		String id = "test";
		
		//when
		memberService.delete(id);
		
		//then
		List<MemberDTO> selectAll = memberService.selectAll();
		
		//then
		assertNotNull(selectAll);
		selectAll.forEach(m -> log.info(m));
	}
	
	@Test
	void getTotalMemberCountTest() {
		//given
		
		
		//when
		int totalMemberCount = memberService.getTotalMemberCount();
		
		//then
		log.info("총 회원 수 : " + totalMemberCount);
	}
	
	
	@Test
	void getRecentMembersTest() {
		//given
		
		
		//when
		List<MemberDTO> recentMembers = memberService.getRecentMembers();
		
		//then
		assertNotNull(recentMembers);
		recentMembers.forEach(m -> log.info(m));
	}
	
	@Test
	void loginTest() {
		//given
		
		//when
		MemberDTO login = memberMapper.login("test", "1234");
		
		//then
		assertNull(login);
		log.info("탈퇴 회원 로그인 결과 값 : " + login);
		
	}

}
