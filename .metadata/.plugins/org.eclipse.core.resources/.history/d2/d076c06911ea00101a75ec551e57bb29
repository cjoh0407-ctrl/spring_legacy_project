<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>관리자 - 회원 관리</title>
<style>
    /* 기존 스타일 유지 */
    body { margin: 0; font-family: 'Malgun Gothic', sans-serif; display: flex; background-color: #f4f7f6; }
    .sidebar { width: 240px; background: #2c3e50; color: white; height: 100vh; position: fixed; }
    .sidebar-header { padding: 20px; text-align: center; background: #1a252f; font-size: 20px; font-weight: bold; }
    .sidebar-menu { padding: 0; list-style: none; }
    .sidebar-menu li a { display: block; padding: 15px 25px; color: #bdc3c7; text-decoration: none; border-bottom: 1px solid #34495e; }
    .sidebar-menu li a:hover { background: #34495e; color: white; }
    .sidebar-menu li a.active { background: #3498db; color: white; }

    .main-content { margin-left: 240px; width: calc(100% - 240px); }
    .admin-header { height: 60px; background: white; border-bottom: 1px solid #ddd; display: flex; align-items: center; justify-content: flex-end; padding: 0 30px; }
    .container { padding: 30px; }
    .page-title { margin-bottom: 20px; color: #333; }

    .admin-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .admin-table th { background: #f8f9fa; padding: 15px; border-bottom: 2px solid #dee2e6; color: #495057; font-size: 14px; }
    .admin-table td { padding: 15px; border-bottom: 1px solid #eee; text-align: center; font-size: 14px; color: #666; }
    
    .badge { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; }
    .badge-admin { background: #e8f4fd; color: #3498db; }
    .badge-user { background: #f1f3f5; color: #868e96; }
    .badge-active { background: #e6fffa; color: #38b2ac; }
    .badge-disabled { background: #fff5f5; color: #e74c3c; } /* 탈퇴 색상 강조 */

    .disabled-row { background-color: #fcfcfc; }
    .disabled-row td { color: #ccc !important; }

    /* 버튼 스타일 추가 및 수정 */
    .btn-action { border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; transition: 0.2s; min-width: 70px; }
    .btn-kick { background: #e74c3c; color: white; }
    .btn-kick:hover { background: #c0392b; }
    .btn-restore { background: #3498db; color: white; }
    .btn-restore:hover { background: #2980b9; }
</style>

<script>
    // 상태 변경 함수 (차단/복구 공용)
    function changeStatus(id, enabled) {
        var msg = enabled ? "해당 회원을 복구하시겠습니까?" : "해당 회원을 강제탈퇴 시키겠습니까?";
        if(confirm(id + "님을 " + msg)) {
            var form = document.getElementById('statusForm');
            form.id.value = id;
            form.enabled.value = enabled;
            form.submit();
        }
    }

    // 컨트롤러에서 보낸 msg 알림창 띄우기
    window.onload = function() {
        var msg = "${msg}";
        if(msg) alert(msg);
    };
</script>
</head>
<body>

    <form id="statusForm" action="/member/admin/updateEnabled" method="post">
        <input type="hidden" name="id">
        <input type="hidden" name="enabled">
    </form>

    <div class="sidebar">
        <div class="sidebar-header">회원 관리 페이지</div>
        <ul class="sidebar-menu">
            <li><a href="/admin/main">대시보드 메인</a></li>
            <li><a href="/admin/board/list">게시판 관리</a></li>
            <li><a href="/member/list" class="active">회원 관리</a></li>
        </ul>
    </div>

    <div class="main-content">
        <header class="admin-header">
            <span>관리자 <b>${sessionScope.member.name}</b>님</span>
            <a href="/member/logout" style="margin-left:15px; color:#e74c3c; text-decoration:none; font-size:13px;">로그아웃</a>
        </header>

        <div class="container">
            <h1 class="page-title">회원 관리</h1>
            <p style="color: #888; margin-bottom: 25px;">회원 활성화 및 차단 상태를 관리합니다.</p>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="100">상태</th>
                        <th width="150">아이디</th>
                        <th width="120">이름</th>
                        <th>이메일</th>
                        <th width="100">권한</th>
                        <th width="120">가입일</th>
                        <th width="120">관리</th>
                    </tr>
                </thead>
                <tbody>
                    <c:forEach var="m" items="${members}"> <tr class="${!m.enabled ? 'disabled-row' : ''}">
                            <td>
                                <span class="badge ${m.enabled ? 'badge-active' : 'badge-disabled'}">
                                    ${m.enabled ? '활동중' : '탈퇴됨'}
                                </span>
                            </td>
                            <td><b>${m.id}</b></td>
                            <td>${m.name}</td>
                            <td>${m.email}</td>
                            <td>
                                <span class="badge ${m.role == 'ADMIN' ? 'badge-admin' : 'badge-user'}">
                                    ${m.role}
                                </span>
                            </td>
                            <td>${m.regdate}</td>
                            <td>
                                <c:choose>
                                    <%-- 본인이 아닐 때만 버튼 활성화 --%>
                                    <c:when test="${m.id != sessionScope.member.id}">
                                        <c:if test="${m.enabled}">
                                            <button type="button" class="btn-action btn-kick" onclick="changeStatus('${m.id}', false)">차단</button>
                                        </c:if>
                                        <c:if test="${!m.enabled}">
                                            <button type="button" class="btn-action btn-restore" onclick="changeStatus('${m.id}', true)">복구</button>
                                        </c:if>
                                    </c:when>
                                    <c:otherwise>
                                        <span style="font-size: 11px; color: #3498db;">본인</span>
                                    </c:otherwise>
                                </c:choose>
                            </td>
                        </tr>
                    </c:forEach>
                    <c:if test="${empty members}">
                        <tr>
                            <td colspan="7" style="padding: 50px; color: #ccc;">가입된 회원이 없습니다.</td>
                        </tr>
                    </c:if>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>