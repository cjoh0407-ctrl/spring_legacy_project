<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<header style="background: #333; color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <a href="/board/list" style="color: white; text-decoration: none; font-size: 20px; font-weight: bold;">My Bulletin Board</a>
    </div>

    <nav>
        <c:choose>
            <%-- 1. 로그인 안 된 상태 --%>
            <c:when test="${empty sessionScope.member}">
                <a href="/" style="color: white; margin-right: 10px;">로그인</a>
                <a href="/member/join" style="color: white;">회원가입</a>
            </c:when>

            <%-- 2. 로그인 된 상태 --%>
            <c:otherwise>
                <span><b>${sessionScope.member.name}</b>님 환영합니다!</span>
                <a href="/member/update" style="color: #ffca28; margin-left: 15px;">정보수정</a>
                <a href="/member/logout" style="color: #ff5252; margin-left: 10px; font-weight: bold;">로그아웃</a>
            </c:otherwise>
        </c:choose>
    </nav>
</header>