<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>관리자 - 회원 관리</title>
<style>
    /* 기존 스타일 유지 (생략 없이 그대로 사용하세요) */
    body { margin: 0; font-family: 'Malgun Gothic', sans-serif; display: flex; background-color: #f4f7f6; }
    .sidebar { width: 240px; background: #2c3e50; color: white; height: 100vh; position: fixed; }
    .sidebar-header { padding: 20px; text-align: center; background: #1a252f; font-size: 20px; font-weight: bold; }
    .sidebar-menu { padding: 0; list-style: none; }
    .sidebar-menu li a { display: block; padding: 15px 25px; color: #bdc3c7; text-decoration: none; border-bottom: 1px solid #34495e; }
    .sidebar-menu li a:hover { background: #34495e; color: white; }
    .sidebar-menu li a.active { background: #3498db; color: white; }
    .main-content { margin-left: 240px; width: calc(100% - 240px); }
    .admin-header { height: 60px; background: white; border-bottom: 1px solid #ddd; display: flex; align-items: center; justify-content: flex-end; padding: 0 30px; }
    .container { padding: 30px; }
    .page-title { margin-bottom: 20px; color: #333; }
    .admin-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .admin-table th { background: #f8f9fa; padding: 15px; border-bottom: 2px solid #dee2e6; color: #495057; font-size: 14px; }
    .admin-table td { padding: 15px; border-bottom: 1px solid #eee; text-align: center; font-size: 14px; color: #666; }
    .badge { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; }
    .badge-admin { background: #e8f4fd; color: #3498db; }
    .badge-user { background: #f1f3f5; color: #868e96; }
    .badge-active { background: #e6fffa; color: #38b2ac; }
    .badge-disabled { background: #fff5f5; color: #e74c3c; }
    .disabled-row { background-color: #fcfcfc; }
    .disabled-row td { color: #ccc !important; }
    .btn-action { border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; transition: 0.2s; min-width: 70px; }
    .btn-kick { background: #e74c3c; color: white; }
    .btn-restore { background: #3498db; color: white; }

    .pagination { display: flex; justify-content: center; list-style: none; padding: 0; margin-top: 30px; gap: 5px; }
    .pagination li a { 
        display: block; padding: 8px 14px; border: 1px solid #ddd; 
        text-decoration: none; color: #333; border-radius: 4px; background: white;
    }
    .pagination li.active a { background: #3498db; color: white; border-color: #3498db; }
    .pagination li a:hover:not(.active) { background: #f4f4f4; }
</style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">회원 관리 페이지</div>
        <ul class="sidebar-menu">
            <li><a href="/admin/main">대시보드 메인</a></li>
            <li><a href="/admin/board/list">게시판 관리</a></li>
            <li><a href="/admin/member/list" class="active">회원 관리</a></li>
        </ul>
    </div>

    <div class="main-content">
        <header class="admin-header">
            <span>관리자 <b>${sessionScope.member.name}</b>님</span>
            <a href="/member/logout" style="margin-left:15px; color:#e74c3c; text-decoration:none; font-size:13px;">로그아웃</a>
        </header>

        <div class="container">
            <h1 class="page-title">회원 관리</h1>
            <p style="color: #888; margin-bottom: 25px;">회원 활성화 및 차단 상태를 관리합니다.</p>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="100">상태</th>
                        <th width="150">아이디</th>
                        <th width="120">이름</th>
                        <th>이메일</th>
                        <th width="100">권한</th>
                        <th width="120">가입일</th>
                        <th width="120">관리</th>
                    </tr>
                </thead>
                <tbody id="memberListBody">
                    <tr><td colspan="7" style="padding:50px;">데이터 로딩 중...</td></tr>
                </tbody>
            </table>

            <ul class="pagination" id="memberPaging"></ul>
        </div>
    </div>

<script>
    // 로그인한 관리자 ID 저장 (본인 제외용)
    const loginId = "${sessionScope.member.id}";
    let currentPage = 1;

    document.addEventListener("DOMContentLoaded", function() {
        loadMemberList(1);
    });

    // 1. 회원 목록 로드
    function loadMemberList(page) {
        currentPage = page;
        fetch("/admin/member/api/list?page=" + page + "&size=10")
            .then(res => res.json())
            .then(data => {
                printTable(data.memberDTOList);
                printPaging(data);
            })
            .catch(err => console.error("회원 로드 실패:", err));
    }

    // 2. 테이블 그리기
    function printTable(list) {
        const tbody = document.getElementById("memberListBody");
        let str = "";
        
        if(list && list.length > 0) {
            list.forEach(m => {
                const disabledClass = m.enabled ? "" : "disabled-row";
                const statusBadge = m.enabled ? "badge-active" : "badge-disabled";
                const statusText = m.enabled ? "활동중" : "탈퇴됨";
                const roleBadge = m.role === 'ADMIN' ? "badge-admin" : "badge-user";

                str += `<tr class="${disabledClass}">`;
                str += `    <td><span class="badge ${statusBadge}">${statusText}</span></td>`;
                str += `    <td><b>${m.id}</b></td>`;
                str += `    <td>${m.name}</td>`;
                str += `    <td>${m.email}</td>`;
                str += `    <td><span class="badge ${roleBadge}">${m.role}</span></td>`;
                str += `    <td>${m.regdateShort}</td>`;
                str += `    <td>`;
                
                // 본인 제외 처리
                if(m.id !== loginId) {
                    if(m.enabled) {
                        str += `<button type="button" class="btn-action btn-kick" onclick="changeStatus('${m.id}', false)">탈퇴</button>`;
                    } else {
                        str += `<button type="button" class="btn-action btn-restore" onclick="changeStatus('${m.id}', true)">복구</button>`;
                    }
                } else {
                    str += `<span style="font-size: 11px; color: #3498db; font-weight: bold; background: #e8f4fd; padding: 5px 10px; border-radius: 4px;">나(관리자)</span>`;
                }
                
                str += `    </td>`;
                str += `</tr>`;
            });
        } else {
            str = '<tr><td colspan="7" style="padding:50px; color:#ccc;">가입된 회원이 없습니다.</td></tr>';
        }
        tbody.innerHTML = str;
    }

    // 3. 페이징 그리기
    function printPaging(data) {
        const pagingUl = document.getElementById("memberPaging");
        let str = "";
        if(data.prev) {
            str += `<li><a href="javascript:loadMemberList(${data.start - 1})">이전</a></li>`;
        }
        data.pageNums.forEach(num => {
            const activeClass = (data.page === num) ? "active" : "";
            str += `<li class="${activeClass}"><a href="javascript:loadMemberList(${num})">${num}</a></li>`;
        });
        if(data.next) {
            str += `<li><a href="javascript:loadMemberList(${data.end + 1})">다음</a></li>`;
        }
        pagingUl.innerHTML = str;
    }

    // 4. 상태 변경 (탈퇴/복구)
	function changeStatus(id, enabled) {
	    const msg = enabled ? "복구하시겠습니까?" : "강제탈퇴 시키겠습니까?";
	    if(!confirm(id + "님을 " + msg)) return;
	
	    fetch("/admin/updateEnabled", {
	        method: 'POST',
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        body: "id=" + id + "&enabled=" + enabled
	    })
	    .then(res => res.text()) // 서버가 리턴한 "OO 계정이 활성화 처리되었습니다"를 읽음
	    .then(message => {
	        alert(message); // 알림창 띄우기
	        loadMemberList(currentPage); // 현재 보던 페이지 리스트만 갱신!
	    })
	    .catch(err => alert("상태 변경 중 오류 발생"));
	}
</script>

</body>
</html>