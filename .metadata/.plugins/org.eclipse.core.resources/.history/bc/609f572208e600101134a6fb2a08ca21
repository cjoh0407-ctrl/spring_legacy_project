package mapper;

import static org.junit.jupiter.api.Assertions.*;

import java.util.List;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.test.context.ContextConfiguration;
import org.springframework.test.context.junit.jupiter.SpringExtension;

import dto.MemberDTO;
import lombok.extern.log4j.Log4j2;

@Log4j2
@ExtendWith(SpringExtension.class)
@ContextConfiguration("file:src/main/webapp/WEB-INF/spring/root-context.xml")
class MemberMapperTest {

	@Autowired
	private MemberMapper memberMapper;
	
	@Test
	void selectAllTest() {
		//given
		
		//when
		List<MemberDTO> list = memberMapper.selectAll();
		
		//then
		assertNotNull(list);
		list.forEach(m -> log.info(m));
	
	}
	
	@Test
	void selectById() {
		//given
		String id = "test";
		
		//when
		MemberDTO dto = memberMapper.selectById(id);
		
		//then
		assertNotNull(dto);
		log.info("One row : " + dto);
	}
	
	
	@Test
	void insertTest() {
		//given
		MemberDTO dto = MemberDTO.builder()
						.id("test")
						.name("test1")
						.password("1234")
						.email("test1@test.com")
						.phone("010-1111-1111")
						.role("admin")
						.build();
		
		//when
		memberMapper.insert(dto);
		
		String id = 1;
		
		//then
		MemberDTO result = memberMapper.selectById(id);
		
		log.info(result);
		
	}
	
	@Test
	void updateTest() {
		//given
		MemberDTO dto = MemberDTO.builder()
				.name("testupdate1")
				.password("1234")
				.email("testupdate1@test.com")
				.phone("010-1111-1111")
				.role("admin")
				.build();
		
		//when
		memberMapper.update(dto);
		
		String id = 1;
		
		//then
		MemberDTO result = memberMapper.selectById(id);
		
		log.info(result);
	}
	
	@Test
	void deleteTest() {
		//given
		
		
		//when
		String id = 1;
		memberMapper.delete(id);
		
		//then
		selectAllTest();
		
	}

}
