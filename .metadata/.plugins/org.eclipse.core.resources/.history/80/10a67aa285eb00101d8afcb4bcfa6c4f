<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>관리자 - 게시판 관리</title>
<style>
    body { margin: 0; font-family: 'Malgun Gothic', sans-serif; display: flex; background-color: #f4f7f6; }
    .sidebar { width: 240px; background: #2c3e50; color: white; height: 100vh; position: fixed; }
    .sidebar-header { padding: 20px; text-align: center; background: #1a252f; font-size: 20px; font-weight: bold; }
    .sidebar-menu { padding: 0; list-style: none; }
    .sidebar-menu li a { display: block; padding: 15px 25px; color: #bdc3c7; text-decoration: none; border-bottom: 1px solid #34495e; }
    .sidebar-menu li a:hover { background: #34495e; color: white; }
    .sidebar-menu li a.active { background: #3498db; color: white; }
    .main-content { margin-left: 240px; width: calc(100% - 240px); }
    .admin-header { height: 60px; background: white; border-bottom: 1px solid #ddd; display: flex; align-items: center; justify-content: flex-end; padding: 0 30px; }
    .container { padding: 30px; }
    .page-title { margin-bottom: 20px; color: #333; }
    .admin-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .admin-table th { background: #f8f9fa; padding: 15px; border-bottom: 2px solid #dee2e6; color: #495057; font-size: 14px; }
    .admin-table td { padding: 15px; border-bottom: 1px solid #eee; text-align: center; font-size: 14px; color: #666; }
    .title-cell { text-align: left !important; }
    .title-cell a { color: #333; text-decoration: none; font-weight: bold; }
    .btn-delete { background: #e74c3c; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }

    .pagination { display: flex; justify-content: center; list-style: none; padding: 0; margin-top: 30px; gap: 5px; }
    .pagination li a { 
        display: block; padding: 8px 14px; border: 1px solid #ddd; 
        text-decoration: none; color: #333; border-radius: 4px; background: white;
    }
    .pagination li.active a { background: #3498db; color: white; border-color: #3498db; }
    .pagination li a:hover:not(.active) { background: #f4f4f4; }
</style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">게시판 관리</div>
        <ul class="sidebar-menu">
            <li><a href="/admin/main">대시보드 메인</a></li>
            <li><a href="/admin/board/list" class="active">게시판 관리</a></li>
            <li><a href="/admin/member/list">회원 관리</a></li>
        </ul>
    </div>

    <div class="main-content">
        <header class="admin-header">
            <span>관리자 <b>${sessionScope.member.name}</b>님</span>
            <a href="/member/logout" style="margin-left:15px; color:#e74c3c; text-decoration:none; font-size:13px;">로그아웃</a>
        </header>

        <div class="container">
            <h1 class="page-title">게시판 관리</h1>
            <p style="color: #888; margin-bottom: 25px;">전체 게시글을 조회하고 관리 권한으로 삭제할 수 있습니다.</p>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th width="100">번호</th>
                        <th>제목</th>
                        <th width="150">작성자</th>
                        <th width="150">작성일</th>
                        <th width="80">조회수</th>
                        <th width="100">관리</th>
                    </tr>
                </thead>
                <tbody id="adminBoardList">
                    <tr><td colspan="6" style="padding:50px;">데이터를 불러오는 중...</td></tr>
                </tbody>
            </table>

            <ul class="pagination" id="adminPaging"></ul>
        </div>
    </div>

<script>
    // 현재 페이지를 기억하기 위한 변수
    let currentPage = 1;

    // 페이지 로드 시 첫 번째 페이지 호출
    document.addEventListener("DOMContentLoaded", function() {
        loadAdminList(1);
    });

    // 데이터를 서버에서 가져오는 핵심 함수
    function loadAdminList(page) {
        currentPage = page;
        // /admin/board/api/list 는 @ResponseBody 컨트롤러 주소여야 합니다.
        const url = "/admin/board/api/list?page=" + page + "&size=10";
        
        fetch(url)
            .then(res => {
                if(!res.ok) throw new Error("데이터 로드 실패");
                return res.json();
            })
            .then(data => {
                printTable(data.boardDTOList); // 테이블 갱신
                printPaging(data);            // 페이징 갱신
            })
            .catch(err => {
                console.error(err);
                document.getElementById("adminBoardList").innerHTML = 
                    '<tr><td colspan="6" style="padding:50px; color:red;">데이터 로드에 실패했습니다.</td></tr>';
            });
    }

    // 테이블 행(tr)을 생성하는 함수
    function printTable(list) {
        const tbody = document.getElementById("adminBoardList");
        let str = "";
        
        if(list && list.length > 0) {
            list.forEach(board => {
                str += "<tr>";
                str += "    <td>" + board.seq + "</td>";
                str += "    <td class='title-cell'><a href='/board/detail?seq=" + board.seq + "' target='_blank'>" + board.title + "</a></td>";
                str += "    <td>" + board.writer + "</td>";
                str += "    <td>" + board.regdateShort + "</td>";
                str += "    <td>" + board.hit + "</td>";
                str += "    <td><button type='button' class='btn-delete' onclick='forceDelete(" + board.seq + ")'>삭제</button></td>";
                str += "</tr>";
            });
        } else {
            str = "<tr><td colspan='6' style='padding:50px; color:#ccc;'>게시글이 존재하지 않습니다.</td></tr>";
        }
        tbody.innerHTML = str;
    }

    // 페이징 버튼을 생성하는 함수
    function printPaging(data) {
        const pagingUl = document.getElementById("adminPaging");
        let str = "";
        
        // 이전 버튼
        if(data.prev) {
            str += "<li><a href='javascript:loadAdminList(" + (data.start - 1) + ")'>이전</a></li>";
        }

        // 페이지 번호들
        data.pageNums.forEach(num => {
            const activeClass = (data.page === num) ? "active" : "";
            str += "<li class='" + activeClass + "'><a href='javascript:loadAdminList(" + num + ")'>" + num + "</a></li>";
        });

        // 다음 버튼
        if(data.next) {
            str += "<li><a href='javascript:loadAdminList(" + (data.end + 1) + ")'>다음</a></li>";
        }
        
        pagingUl.innerHTML = str;
    }

    // 강제 삭제 함수 (비동기 처리 가능하도록 설계)
    function forceDelete(seq) {
        if(!confirm(seq + "번 게시글을 정말 강제로 삭제하시겠습니까?")) return;

        // 삭제 처리도 비동기로 하면 화면이 튀지 않습니다.
        // 주소는 사용자의 컨트롤러 설정에 맞춰 확인해 주세요.
        fetch("/admin/boardDelete?seq=" + seq, { method: 'POST' })
            .then(res => res.text())
            .then(result => {
                if(result === "success") {
                    alert("삭제되었습니다.");
                    loadAdminList(currentPage); // 현재 보던 페이지 리스트만 새로고침!
                } else {
                    alert("삭제 실패");
                }
            })
            .catch(err => alert("삭제 중 오류 발생"));
    }
</script>

</body>
</html>